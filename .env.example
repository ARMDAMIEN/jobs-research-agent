# Required
ANTHROPIC_API_KEY=sk-ant-...
SERPAPI_API_KEY=
APOLLO_API_KEY=

# Gmail OAuth2 (run `npm run gmail:token` once to obtain the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@example.com
GMAIL_SENDER_NAME=Damien A.

# Sender signature fields (used in email body)
SENDER_FIRST_NAME=Damien A.
SENDER_TITLE=Admin & Ops Consultant

# Telegram notification (run summary sent as final step)
TELEGRAM_BOT_API_KEY=
TELEGRAM_CHAT_ID=

# Agent tuning
CLAUDE_MODEL=claude-sonnet-4-5
MAX_COMPANY_SIZE=20
MAX_LEADS_PER_RUN=5
